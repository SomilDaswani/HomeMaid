{
  "expo": {
    "name": "HomeMaid",
    "slug": "homemaid",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homemaid.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "HomeMaid ko awaz sunne ki permission chahiye taake aap apni request bol sakein."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDuaZpBYJMCwElZVRO9wgLw6YbJFikW0lI"
      }
    },
    "android": {
      "package": "com.homemaid.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDuaZpBYJMCwElZVRO9wgLw6YbJFikW0lI"
        }
      }
    },
    "web": {},
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "HomeMaid uses your location to find nearby maids."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "HomeMaid ko awaz sunne ki permission chahiye taake aap apni request bol sakein."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5CF6"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "3bc64916-35cb-4f35-baf4-74d716f7211d"
      }
    }
  }
}
